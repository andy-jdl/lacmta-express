<div class="bus-route-container">
  <div class="bus-route-header">
    <h1>
      <img src="/assets/bus-sq.png" alt="Metro Bus Icon" class="header-icon" />
      Metro Bus Routes
    </h1>
      <p class="mta">
        Text a Metro bus stop number (e.g. "LACMTA 420") to <a href="sms:+12137546272">+1 (213) 754-6272</a> to receive real-time arrival predictions.
        Msg &amp; data rates may apply. Reply STOP to opt out at any time.
      </p>
      <a href="/privacypolicy">Privacy Policy</a>
      <a href="/termsconditions">Terms & Conditions</a>
      <a href="https://github.com/andy-jdl/lacmta-express">Github</a>
      <p>Last Updated: {{ date }}</p>
  </div>
  <ul>
    {% for route in routes %}
      <li>
        <a href="/routes/{{ route.route_code }}">{{ route.route_code }}</a>
      </li>
    {% endfor %}
  </ul>
</div>