---
layout: routelayout.njk
pagination:
  data: routes
  size: 1
  alias: route
permalink: "/routes/{{ route.route_code }}/index.html"
eleventyComputed:
  title: "Route {{ route.route_code }}"
---
<h3>Note: Direction Id may refer to North/East (0) or South/West (1). Understand your bus route and text the appropriate Stop ID</h3>
<a href="/">Back to Home</a>
<table>
  <tr>
    <th>Stop ID</th>
    <th>Street Crossing</th>
    <th>Destination Id</th>
  </tr>
  {% for stop in route.stops %}
    <tr>
      <td>{{ stop.stop_id }}</td>
      <td>{{ stop.stop_name }}</td>
      <td>{{ stop.direction_id }}</td>
    </tr>
  {% endfor %}
</table>